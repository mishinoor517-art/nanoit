# Copy this file to .env and fill in your real values.
# .env is already gitignored so your credentials stay private.

# --- SMTP (used to email you when someone submits the Contact form) ---
# Any SMTP provider works — including Hostinger's own email hosting
# (hPanel → Emails → your address → "Configure Email Client" for the
# host/port), or Gmail, Zoho, SendGrid, etc.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your-email-password

# Which inbox should receive contact form enquiries.
# Defaults to SMTP_USER if left blank.
CONTACT_TO_EMAIL=your-business-email@yourdomain.com
